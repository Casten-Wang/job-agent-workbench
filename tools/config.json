{
  "_note": "TASK-03 本地 JD 录入 / 硬规则 / ATS / 经历变体的全部默认参数。按提示词第 4.1 节用 JSON 代替 YAML，只用 Python 3 标准库 json 读取。本文件不含凭据、真实个人信息、平台接口地址；本任务不联网、不打分、不投递。",
  "target_cities": ["上海", "长宁"],
  "city_match_mode": "contains",
  "city_empty_policy": "pass_with_warning",
  "city_not_allowed_policy": "reject",
  "excluded_terms": ["外包", "驻场", "单休", "电销"],
  "excluded_term_policy": "reject",
  "title_keywords": ["AI产品经理", "商业分析师", "跨境电商", "产品经理", "数据分析"],
  "title_keyword_policy": "warn",
  "salary": {
    "_note": "薪资下限单位元/月。支持 15k-25k、15000-25000、面议 等写法；无法解析时放行并记 warning，不猜测。",
    "min_threshold": 15000,
    "unparsable_policy": "pass_with_warning",
    "unparsable_markers": ["面议", "薪资面议", "negotiable"],
    "k_units": ["k", "K", "千"],
    "k_multiplier": 1000,
    "range_pattern": "(?P<min>\\d+(?:\\.\\d+)?)\\s*(?P<min_unit>[kK千]?)\\s*(?:-|–|—|~|～|至|到)\\s*(?P<max>\\d+(?:\\.\\d+)?)\\s*(?P<max_unit>[kK千]?)",
    "amount_pattern": "(?P<amount>\\d+(?:\\.\\d+)?)\\s*(?P<unit>[kK千]?)\\s*(?:元\\s*/?\\s*月|元|/月)?"
  },
  "fingerprint": {
    "_note": "sha256(normalize(company) + '|' + normalize(title) + '|' + normalize(city))。normalize 与 tools/precheck.py 一致：NFKC + casefold + 空白折叠；公司额外去掉常见法律后缀。",
    "algorithm": "sha256",
    "separator": "|",
    "fields": ["company", "title", "city"],
    "encoding": "utf-8",
    "normalizer_module": "precheck"
  },
  "score": {
    "_note": "高分阈值与审批区间只写入配置；按提示词第 2 节，本任务不调用 LLM 打分，也不读取这些值参与过滤。",
    "high_threshold": 4.5,
    "approval_min": 4.0,
    "approval_max": 4.4
  },
  "analytics": {
    "_note": "M17 埋点字段初始值。Source_Channel 取自 JD 明确标记的 source_channel；Rejection_Reason 初始 null；LLM_Rewrite_Edited_Flag 初始 false。TASK-03 规格字段名与 PLAN.md M17 的 LLM_Edited_Flag 不同，按规格实现，差异在验收文档记为未确认。",
    "Source_Channel": {"source_field": "source_channel"},
    "Rejection_Reason": {"initial": null},
    "LLM_Rewrite_Edited_Flag": {"initial": false}
  },
  "jd_markers": {
    "_note": "JD 纯文本按明确的「标签：值」逐行解析。标签只在本配置列出；不在自由文本里猜字段。is_job_post 可由显式标记决定，或由 company/title 两个明确字段同时存在推导。salary_min/salary_max 也支持显式标记；salary 标记用于薪资范围或面议原文。",
    "company": ["公司", "公司名称", "企业名称", "Company", "company"],
    "title": ["岗位", "职位", "岗位名称", "职位名称", "Title", "title"],
    "city": ["城市", "工作城市", "地点", "工作地点", "City", "city"],
    "salary": ["薪资", "薪酬", "月薪", "工资", "薪资范围", "Salary", "salary"],
    "salary_min": ["薪资下限", "最低薪资", "Salary_Min", "salary_min"],
    "salary_max": ["薪资上限", "最高薪资", "Salary_Max", "salary_max"],
    "source_channel": ["来源渠道", "渠道", "来源", "Source_Channel", "source_channel"],
    "posted_at": ["发布时间", "发布日期", "Posted_At", "posted_at"],
    "contact": ["联系方式", "联系人", "Contact", "contact"],
    "is_job_post": ["记录类型", "类型", "IsJobPost", "is_job_post"],
    "job_post_yes_values": ["JD", "job", "job_post", "true", "yes", "1"],
    "is_job_post_require_fields": ["company", "title"]
  },
  "variants_dir": "tools/data/variants",
  "input_anomaly_patterns": {
    "_note": "仅用于把 JD 中疑似指令的文本原样摘录到 input_anomalies，绝不执行；不是过滤规则，也不是第 2 节默认参数。",
    "patterns": [
      "ignore\\s+(all\\s+|any\\s+|the\\s+|previous\\s+|above\\s+)?(instructions?|rules?|constraints?)",
      "忽略[^\\n]{0,20}(以上|上述|之前|所有|前面)[^\\n]{0,20}(指令|约束|规则|提示词)",
      "改变[^\\n]{0,20}(任务|目标|规则|约束)",
      "提交[^\\n]{0,20}(申请|投递)",
      "写入[^\\n]{0,20}凭据",
      "api[_ -]?key|password|credential|secret",
      "\\bsystem\\s*:",
      "you are now"
    ]
  },
  "warning_codes": {
    "city_missing": "city-missing",
    "salary_unparsable": "salary-unparsable",
    "title_direction": "title-direction-not-matched",
    "missing_company": "missing-company",
    "missing_title": "missing-title",
    "not_job_post": "is-job-post-false"
  },
  "reason_codes": {
    "excluded_term": "excluded-term",
    "salary_below_min": "salary-below-min",
    "city_not_allowed": "city-not-allowed"
  }
}
